<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/userRegistrationFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.dsource.idc.jellowintl.activities.SplashFragment"
        android:label="SplashFragment"
        tools:layout="@layout/activity_splash" />

    <fragment
        android:id="@+id/tutorialFragment"
        android:name="com.dsource.idc.jellowintl.activities.TutorialFragment"
        android:label="TutorialFragment"
        tools:layout="@layout/activity_tutorial" />

    <fragment
        android:id="@+id/userRegistrationFragment"
        android:name="com.dsource.idc.jellowintl.activities.UserRegistrationFragment"
        android:label="UserRegistrationFragment"
        tools:layout="@layout/activity_user_registration">
        <action
            android:id="@+id/action_userRegistrationFragment_to_languageDownloadFragment"
            app:destination="@id/languageDownloadFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_userRegistrationFragment_to_introFragment"
            app:destination="@id/introFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_userRegistrationFragment_to_splashFragment"
            app:destination="@id/splashFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/languageDownloadFragment"
        android:name="com.dsource.idc.jellowintl.activities.LanguageDownloadFragment"
        android:label="LanguageDownloadFragment"
        tools:layout="@layout/activity_language_download">
        <argument
            android:name="LCODE"
            app:argType="string" />
        <argument
            android:name="SPLASH"
            app:argType="boolean"
            android:defaultValue="true" />
        <argument
            android:name="TUTORIAL"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="CLOSE"
            app:argType="boolean"
            android:defaultValue="false" />
        <action
            android:id="@+id/action_languageDownloadFragment_to_introFragment"
            app:destination="@id/introFragment"
            app:popUpTo="@id/languageDownloadFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_languageDownloadFragment_to_splashFragment"
            app:destination="@id/splashFragment"
            app:popUpTo="@id/languageDownloadFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/introFragment"
        android:name="com.dsource.idc.jellowintl.activities.IntroFragment"
        android:label="IntroFragment"
        tools:layout="@layout/fragment_intro">
        <action
            android:id="@+id/action_introFragment_to_splashFragment"
            app:destination="@id/splashFragment" />
    </fragment>


    <fragment
        android:id="@+id/settingFragment"
        android:name="com.dsource.idc.jellowintl.activities.SettingFragment"
        android:label="SettingFragment"
        tools:layout="@layout/activity_setting" />

    <fragment
        android:id="@+id/profileFormFragment"
        android:name="com.dsource.idc.jellowintl.activities.ProfileFormFragment"
        android:label="ProfileFormFragment"
        tools:layout="@layout/activity_profile_form" />

    <fragment
        android:id="@+id/aboutJellowFragment"
        android:name="com.dsource.idc.jellowintl.activities.AboutJellowFragment"
        android:label="AboutJellowFragment"
        tools:layout="@layout/activity_about_jellow" />

    <fragment
        android:id="@+id/languageSelectFragment"
        android:name="com.dsource.idc.jellowintl.activities.LanguageSelectFragment"
        android:label="LanguageSelectFragment"
        tools:layout="@layout/activity_language_select" />

    <fragment
        android:id="@+id/languagePackUpdateFragment"
        android:name="com.dsource.idc.jellowintl.activities.LanguagePackUpdateFragment"
        android:label="LanguagePackUpdateFragment"
        tools:layout="@layout/activity_language_pack_update_activity" />

    <fragment
        android:id="@+id/resetPreferencesFragment"
        android:name="com.dsource.idc.jellowintl.activities.ResetPreferencesFragment"
        android:label="ResetPreferencesFragment"
        tools:layout="@layout/activity_reset_preferences" />

    <fragment
        android:id="@+id/accessibilitySettingsFragment"
        android:name="com.dsource.idc.jellowintl.activities.AccessibilitySettingsFragment"
        android:label="AccessibilitySettingsFragment"
        tools:layout="@layout/activity_accessibility_settings" />

    <fragment
        android:id="@+id/feedbackFragment"
        android:name="com.dsource.idc.jellowintl.activities.FeedbackFragment"
        android:label="FeedbackFragment"
        tools:layout="@layout/activity_feedback" />

    <fragment
        android:id="@+id/feedbackTalkBackFragment"
        android:name="com.dsource.idc.jellowintl.activities.FeedbackTalkBackFragment"
        android:label="FeedbackTalkBackFragment"
        tools:layout="@layout/activity_feedback_talkback" />

    <fragment
        android:id="@+id/keyboardInputFragment"
        android:name="com.dsource.idc.jellowintl.activities.KeyboardInputFragment"
        android:label="KeyboardInputFragment"
        tools:layout="@layout/activity_keyboard_input" />

</navigation>

